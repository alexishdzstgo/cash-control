NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias legado aceptado si el proyecto todavía usa el nombre anterior.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Alias legado aceptado solo en servidor.
# SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=

# Terminal-only bootstrap. Never copy mock credentials; do not commit values.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_OWNER_FIRST_NAME=
BOOTSTRAP_OWNER_LAST_NAME=
BOOTSTRAP_OWNER_USERNAME=
# Opcional: si se omite, el bootstrap genera una credencial Auth aleatoria
# que no se muestra ni se usa en el acceso cotidiano por PIN.
# BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_PIN=

# Terminal-only provisioning of an existing Supabase Auth owner.
# Defaults target Zeferino in cash-control with PIN 1234.
# OWNER_AUTH_EMAIL=zeferino@cashcontrol.com
# OWNER_BUSINESS_SLUG=cash-control
# OWNER_FIRST_NAME=Zeferino
# OWNER_LAST_NAME=Zeferino
# OWNER_DISPLAY_NAME=Zeferino
# OWNER_USERNAME=zeferino
# OWNER_PIN=1234
